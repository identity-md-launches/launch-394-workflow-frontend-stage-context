{
  "name": "lab-donation-vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Single-page frontend for the Piggy DonationVault4626 on Sepolia",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
