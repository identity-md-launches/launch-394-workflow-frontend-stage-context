    "check": "npm run typecheck && npm run test && npm run export"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
